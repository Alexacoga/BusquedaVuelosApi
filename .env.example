# Copia este fichero a .env y rellena al menos una de las dos claves.

# Travelpayouts / Aviasales Data API (gratis, sin límite mensual de consultas)
# Alta: https://www.travelpayouts.com -> conectar el programa Aviasales -> Herramientas -> API
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKET=es
# Opcional: tu marker de afiliado; se añade a los enlaces de reserva
TRAVELPAYOUTS_MARKER=

# SerpApi - Google Flights / Google Travel Explore (250 búsquedas/mes gratis)
# Alta: https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

DEFAULT_CURRENCY=EUR
LANGUAGE=es
COUNTRY=es
# Segundos que se guardan las respuestas en caché (ahorra cuota)
CACHE_TTL_SECONDS=21600
HTTP_TIMEOUT_SECONDS=30
